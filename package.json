{
  "name": "kitty-browser",
  "productName": "Kitty",
  "version": "0.3.0",
  "description": "Kitty — um navegador rápido e focado em privacidade",
  "author": {
    "name": "Kitty"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/build-icon.js",
    "dist": "electron-packager . Kitty --asar-integrity-digest=false --asar.unpack='*.node' --download.mirrorOptions.mirror=https://github.com/castlabs/electron-releases/releases/download/ --platform=darwin --arch=arm64 --out=out --overwrite --icon=assets/icon.icns --app-bundle-id=app.kitty.browser --app-category-type=public.app-category.productivity --app-copyright='Kitty' --protocol=http --protocol-name='Web (HTTP)' --protocol=https --protocol-name='Web (HTTPS)' --extend-info=assets/Info.extra.plist --ignore='^/(out|scripts|assets|README.md|\\.gitignore|\\.venv|native)'",
    "postdist": "sh scripts/sign-mac.sh",
    "install-app": "npm run dist && rm -rf /Applications/Kitty.app && cp -R out/Kitty-darwin-arm64/Kitty.app /Applications/",
    "postinstall": "node node_modules/electron/install.js",
    "evs-signup": ".venv/bin/python -m castlabs_evs.account signup",
    "dist:win": "electron-builder --win nsis --x64",
    "release:win": "sh scripts/release-win.sh",
    "release:mac": "sh scripts/release-mac.sh",
    "build:native": "sh scripts/build-native.sh",
    "predist": "npm run build:native && npm run lists",
    "prestart": "[ -f src/main/native/swipe_phase.node ] || npm run build:native",
    "lists": "electron scripts/build-lists.js",
    "predist:win": "npm run lists"
  },
  "license": "MPL-2.0",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "26.16.1",
    "node-gyp": "13.0.2"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "electron-updater": "6.8.9"
  },
  "build": {
    "appId": "app.kitty.browser",
    "productName": "Kitty",
    "copyright": "Kitty",
    "electronVersion": "44.1.0+wvcus",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "directories": {
      "output": "out/windows",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "!src/main/native/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-win.png",
      "artifactName": "Kitty-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kitty",
      "uninstallDisplayName": "Kitty",
      "include": "assets/installer.nsh",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CaioGobbi",
        "repo": "kitty-browser",
        "releaseType": "release"
      }
    ],
    "afterSign": "scripts/evs-after-sign.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/caiogobbi/kitty-browser.git"
  },
  "homepage": "https://github.com/caiogobbi/kitty-browser"
}
